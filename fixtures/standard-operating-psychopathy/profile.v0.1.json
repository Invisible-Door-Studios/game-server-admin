      {
        "key": "ums_package_id",
        "type": "string",
        "required": false,
        "visibility": "operator",
        "minLength": 1
      },
      {
        "key": "ums_profile_id",
        "type": "string",
        "required": false,
        "visibility": "operator",
        "minLength": 1
      },
      {
        "key": "scenario_version",
        "type": "string",
        "required": false,
        "visibility": "operator",
        "minLength": 1
